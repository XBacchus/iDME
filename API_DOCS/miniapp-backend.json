{
  "openapi": "3.0.3",
  "info": {
    "title": "miniapp-backend API",
    "version": "0.1.2"
  },
  "paths": {
    "/api/parts": {
      "post": {
        "summary": "Create part",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "summary": "List parts",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/parts/{id}": {
      "delete": {
        "summary": "Delete part",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/parts/categories": {
      "get": {
        "summary": "Get category tree",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/parts/{id}/bom": {
      "post": {
        "summary": "Add BOM relation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/equipments": {
      "get": {
        "summary": "List equipments",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search by code, name, manufacturer, brand, model, supplier, or location"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Create equipment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EquipmentWriteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/equipments/{id}": {
      "get": {
        "summary": "Get equipment detail",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "summary": "Update equipment",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EquipmentWriteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "summary": "Delete equipment",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/working-plans": {
      "get": {
        "summary": "List working plans",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search by working plan code or name"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Create working plan",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkingPlanWriteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/working-plans/{id}": {
      "get": {
        "summary": "Get working plan detail",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "summary": "Update working plan",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkingPlanWriteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "summary": "Delete working plan",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/working-plans/{id}/processes": {
      "get": {
        "summary": "Get process flow",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "summary": "Update process flow",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/working-plans/{id}/procedures": {
      "post": {
        "summary": "Append procedure to working plan",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EquipmentWriteRequest": {
        "type": "object",
        "required": [
          "equipmentCode",
          "equipmentName",
          "manufacturer"
        ],
        "properties": {
          "equipmentCode": {
            "type": "string"
          },
          "equipmentName": {
            "type": "string"
          },
          "manufacturer": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "specModel": {
            "type": "string"
          },
          "supplier": {
            "type": "string"
          },
          "productionDate": {
            "type": "string",
            "description": "Optional; backend falls back and persists echo data if xDM rejects this value"
          },
          "serviceLifeYears": {
            "type": "integer"
          },
          "depreciationMethod": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "technicalParams": {
            "type": "string"
          },
          "sparePartsInfo": {
            "type": "string"
          }
        }
      },
      "WorkingPlanWriteRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Working plan code"
          },
          "name": {
            "type": "string",
            "description": "Working plan name"
          },
          "operator": {
            "type": "string",
            "description": "Operator"
          },
          "operationTime": {
            "type": "string",
            "description": "Operation time"
          },
          "equipment": {
            "type": "string",
            "description": "Equipment usage"
          },
          "product": {
            "type": "string",
            "description": "Related product"
          },
          "version": {
            "type": "string",
            "description": "Version"
          },
          "description": {
            "type": "string",
            "description": "Working plan description"
          }
        }
      }
    }
  }
}
